# .gitconfig
# Included from ~/.gitconfig by scripts/symlink.sh; machine-local settings
# (hooksPath, work email, ...) belong in ~/.gitconfig itself
[user]
  name = charliestras
  email = charliestras@gmail.com

[core]
  editor = nvim
  quotepath = false

[pull]
  rebase = false

[push]
  default = simple

[init]
  defaultBranch = main

[alias]
  st = status
  co = checkout
  br = branch
  lg = log --oneline --graph --decorate --all
