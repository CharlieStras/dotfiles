# .gitconfig
[user]
  name = charliestras
  email = charliestras@gmail.com

[core]
  editor = nvim
  excludesfile = ~/.gitignore_global

[pull]
  rebase = false

[push]
  default = simple

[init]
  defaultBranch = main

[alias]
  st = status
  co = checkout
  br = branch
  lg = log --oneline --graph --decorate --all